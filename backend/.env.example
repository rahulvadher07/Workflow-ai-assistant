DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# DB_ENGINE: 'sqlite' (easy local development) or 'postgresql' (production target)
DB_ENGINE=sqlite
DB_NAME=ai_ops_platform
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Only used when DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production security toggles (leave False for local HTTP dev) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=10

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Groq AI ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# --- Email ---
# Console backend is safest for local development. For real email, switch
# EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend and fill these.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@company.local

# --- Redis / Channels / Celery ---
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CHANNEL_LAYER=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Automation windows ---
TASK_REMINDER_WINDOW_HOURS=24
ISSUE_ESCALATION_HOURS=24

# --- AI observability ---
AI_OBSERVABILITY_ENABLED=True
AI_LOG_LEVEL=INFO

# Optional semantic Knowledge & Policy retrieval
AI_SEMANTIC_RETRIEVAL_ENABLED=True
AI_SEMANTIC_MODEL=all-MiniLM-L6-v2
